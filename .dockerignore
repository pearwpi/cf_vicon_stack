# Keep the build context small and reproducible.
**/__pycache__
**/*.pyc
build/
install/
log/
_to_delete/
.git/

# Captures are large and not needed in the image -- EXCEPT the one the test
# suite replays during the build. .dockerignore has no trailing-comment
# support, so the negation must sit on a line of its own, after the exclude.
*.csv
!tilt_capture_1786563877.csv
.env
